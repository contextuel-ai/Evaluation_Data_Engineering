@base <https://www.contextuel.ai/spec/Enki/> .
@prefix enki: <https://www.contextuel.ai/spec/Enki/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix contextuel: <https://www.contextuel.ai/spec/Contextuel/> .

# ============================================================
# PROPOSED NEW CAPABILITIES
# ============================================================

# ------------------------------------------------------------
# FormalReasoning (consolidates LogicalDeduction + AlgorithmicReasoning)
# ------------------------------------------------------------
# Justification: BBH tasks span both deductive logic (Boolean
# expressions, syllogisms, formal fallacies) and procedural
# simulation (navigate, tracking shuffled objects, web of lies).
# These share the core property of applying deterministic,
# structured rules step-by-step. Splitting them yields two
# capabilities that are both mapped exclusively to BBH with
# significant overlap in what they describe. Consolidating
# preserves the distinction from softer reasoning modes
# (CommonsenseReasoning) without artificial granularity.
#
# Tested by: BBH
# Parent:    MultiStepReasoning
# ------------------------------------------------------------
contextuel:FormalReasoning a enki:Capability ;
    rdfs:label "Formal Reasoning" ;
    dct:description "The ability of an LLM to apply structured logical rules and simulate procedural execution, including syllogistic reasoning, Boolean logic evaluation, truth-table analysis, state tracking, and step-by-step algorithmic operations." ;
    enki:subsumedByCapability contextuel:MultiStepReasoning .

contextuel:MultiStepReasoning
    enki:subsumesCapability contextuel:FormalReasoning .

# ------------------------------------------------------------
# CommonsenseReasoning
# ------------------------------------------------------------
# Justification: MUSR tests reasoning over narratives where
# the model must integrate implicit world knowledge and
# commonsense assumptions. Distinct from FormalReasoning
# (no deterministic rules) and from CausalReasoning (broader
# than cause-and-effect alone — includes social understanding,
# spatial reasoning, everyday physics).
#
# Tested by: MUSR
# Parent:    MultiStepReasoning
# ------------------------------------------------------------
contextuel:CommonsenseReasoning a enki:Capability ;
    rdfs:label "Commonsense Reasoning" ;
    dct:description "The ability of an LLM to draw plausible inferences based on implicit world knowledge, everyday physical and social understanding, and narrative comprehension, even when the reasoning steps are not formally specified." ;
    enki:subsumedByCapability contextuel:MultiStepReasoning .

contextuel:MultiStepReasoning
    enki:subsumesCapability contextuel:CommonsenseReasoning .

# ------------------------------------------------------------
# CausalReasoning
# ------------------------------------------------------------
# Justification: Both BBH ("causal judgment") and MUSR
# (murder mysteries, event attribution) require identifying
# cause-and-effect relationships. This capability spans the
# formal/commonsense divide — causal reasoning can be either
# deductive (controlled experiments) or abductive (narrative
# inference). It is the only capability mapped to both BBH
# and MUSR, confirming it is a cross-cutting concern rather
# than a subset of either FormalReasoning or Commonsense-
# Reasoning alone.
#
# Tested by: BBH, MUSR
# Parent:    MultiStepReasoning
# ------------------------------------------------------------
contextuel:CausalReasoning a enki:Capability ;
    rdfs:label "Causal Reasoning" ;
    dct:description "The ability of an LLM to identify, evaluate, and reason about cause-and-effect relationships between events, actions, and outcomes, including counterfactual reasoning and distinguishing correlation from causation." ;
    enki:subsumedByCapability contextuel:MultiStepReasoning .

contextuel:MultiStepReasoning
    enki:subsumesCapability contextuel:CausalReasoning .

# ------------------------------------------------------------
# LongContextReasoning
# ------------------------------------------------------------
# Justification: The Artificial Analysis LCR (Long-Context
# Reasoning) benchmark specifically measures a model's ability
# to locate, synthesise, and reason over information spread
# across very long input contexts (100k+ tokens). This is
# distinct from MultiStepReasoning (which focuses on
# sequential logical operations regardless of context length)
# and from FactualRecall (which tests retrieval of training
# data, not in-context information). Long-context reasoning
# requires both attention over large spans and the ability to
# integrate dispersed evidence — a capability not captured by
# any existing node.
#
# Tested by: LCR (Artificial Analysis)
# Parent:    Reasoning
# ------------------------------------------------------------
contextuel:LongContextReasoning a enki:Capability ;
    rdfs:label "Long-Context Reasoning" ;
    dct:description "The ability of an LLM to accurately retrieve, synthesise, and reason over information distributed across long input contexts, including multi-document comprehension, needle-in-a-haystack recall, and cross-passage inference." ;
    enki:subsumedByCapability contextuel:Reasoning .

contextuel:Reasoning
    enki:subsumesCapability contextuel:LongContextReasoning .

# ============================================================
# CONSOLIDATED HIERARCHY
# ============================================================
#
# Reasoning
# ├── MultiStepReasoning
# │   ├── MathematicalReasoning          ← NEW (MATH Lvl5)
# │   ├── FormalReasoning                ← NEW (BBH) [consolidates LogicalDeduction + AlgorithmicReasoning]
# │   ├── CommonsenseReasoning           ← NEW (MUSR)
# │   ├── CausalReasoning               ← NEW (BBH, MUSR) [cross-cutting]
# │   └── ExpertLevelProblemSolving      ← NEW (GPQA) [also under AcademicDomainKnowledge]
# ├── GeneralKnowledgeReasoning
# ├── LongContextReasoning               ← NEW (LCR, Artificial Analysis)
#
# Knowledge
# ├── AcademicDomainKnowledge
# │   └── ExpertLevelProblemSolving      ← NEW (GPQA)
# ├── FactualRecall
# ├── GeneralKnowledgeReasoning
#
# ConversationalReasoning
# ├── InstructionFollowing               ← used by IFEval
# ├── ContextRetention
# ├── MultiTurnDialogue
# └── ResponseHelpfulness
#
# ============================================================
