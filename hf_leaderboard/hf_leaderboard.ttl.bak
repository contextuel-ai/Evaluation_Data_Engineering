contextuel:AbstractPatternRecognition a enki:Capability ;
    dct:description "The ability of an LLM to identify underlying mathematical structures and patterns from problem descriptions." ;
    rdfs:label "Abstract Pattern Recognition" .

contextuel:AcademicDomainKnowledge a enki:Capability ;
    dct:description "The ability of an LLM to demonstrate understanding of specialized subject matter such as law, medicine, physics, or history." ;
    rdfs:label "Academic Domain Knowledge" .

contextuel:AdvancedMathematicalReasoning a enki:Capability ;
    dct:description "The ability of an LLM to solve competition-level mathematics problems requiring deep mathematical knowledge." ;
    rdfs:label "Advanced Mathematical Reasoning" .

contextuel:AlgorithmicReasoning a enki:Capability ;
    dct:description "The ability of an LLM to follow and execute step-by-step algorithmic procedures." ;
    rdfs:label "Algorithmic Reasoning" .

contextuel:CausalReasoning a enki:Capability ;
    dct:description "The ability of an LLM to identify and reason about cause-and-effect relationships between events or statements." ;
    rdfs:label "Causal Reasoning" .

contextuel:ConceptualTransfer a enki:Capability ;
    dct:description "The ability of an LLM to apply concepts learned in one domain to novel problems in a related but distinct domain." ;
    rdfs:label "Conceptual Transfer" .

contextuel:ConstraintSatisfaction a enki:Capability ;
    dct:description "The ability of an LLM to satisfy multiple simultaneous constraints within a single response." ;
    rdfs:label "Constraint Satisfaction" .

contextuel:CounterfactualReasoning a enki:Capability ;
    dct:description "The ability of an LLM to reason about hypothetical scenarios and determine what would follow under altered conditions." ;
    rdfs:label "Counterfactual Reasoning" .

contextuel:DistractorDiscrimination a enki:Capability ;
    dct:description "The ability of an LLM to distinguish correct answers from plausible but incorrect alternatives in multiple-choice settings." ;
    rdfs:label "Distractor Discrimination" .

contextuel:FactualRecall a enki:Capability ;
    dct:description "The ability of an LLM to accurately retrieve and reproduce learned factual information from its training data." ;
    rdfs:label "Factual Recall" .

contextuel:GeneralKnowledgeReasoning a enki:Capability ;
    dct:description "The ability of an LLM to apply broad academic knowledge across multiple disciplines to correctly answer domain-specific questions." ;
    rdfs:label "General Knowledge Reasoning" .

contextuel:GraduateLevelReasoning a enki:Capability ;
    dct:description "The ability of an LLM to reason at the level expected of domain experts in graduate-level science." ;
    rdfs:label "Graduate-Level Reasoning" .

contextuel:ImplicitInformationExtraction a enki:Capability ;
    dct:description "The ability of an LLM to infer unstated facts and relationships from contextual clues in a passage." ;
    rdfs:label "Implicit Information Extraction" .

contextuel:InstructionFollowing a enki:Capability ;
    dct:description "The ability of an LLM to understand and correctly execute user-provided instructions." ;
    rdfs:label "Instruction Following" .

contextuel:InterdisciplinarySynthesis a enki:Capability ;
    dct:description "The ability of an LLM to integrate knowledge from multiple scientific domains to answer complex questions." ;
    rdfs:label "Interdisciplinary Synthesis" .

contextuel:LogicalDeduction a enki:Capability ;
    dct:description "The ability of an LLM to derive conclusions from given premises using formal logical rules." ;
    rdfs:label "Logical Deduction" .

contextuel:LongContextUnderstanding a enki:Capability ;
    dct:description "The ability of an LLM to comprehend and reason over long narrative passages." ;
    rdfs:label "Long Context Understanding" .

contextuel:MultiStepReasoning a enki:Capability ;
    dct:description "The ability of an LLM to perform sequential logical operations to arrive at a correct conclusion." ;
    rdfs:label "Multi-Step Reasoning" .

contextuel:NarrativeComprehension a enki:Capability ;
    dct:description "The ability of an LLM to track characters, events, and plot developments across extended text." ;
    rdfs:label "Narrative Comprehension" .

contextuel:OutputFormatCompliance a enki:Capability ;
    dct:description "The ability of an LLM to produce outputs that conform to specified formatting constraints." ;
    rdfs:label "Output Format Compliance" .

contextuel:PrecisionOfExpression a enki:Capability ;
    dct:description "The ability of an LLM to generate responses that are exact and unambiguous in wording when explicitly required." ;
    rdfs:label "Precision of Expression" .

contextuel:ProofConstruction a enki:Capability ;
    dct:description "The ability of an LLM to construct valid mathematical arguments and formal or semi-formal proofs." ;
